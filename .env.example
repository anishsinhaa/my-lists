# Login name checked by the server.
AUTH_USERNAME=
# bcrypt hash of the password. Generate with: npm run hash -- "your-password"
AUTH_PASSWORD_HASH=
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# JWT lifetime. Example: 30d
JWT_EXPIRES_IN=30d
# Allow 'Continue as guest' (read-only). true or false.
GUEST_MODE=true
# Guest session lifetime. Example: 7d
GUEST_EXPIRES_IN=7d
# Spreadsheet id from the sheet URL, between /d/ and /edit. Server only.
GOOGLE_SHEET_ID=
# Service account client_email. Share the sheet with this address. Server only.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account private_key. Real newlines or literal \n sequences. Server only.
GOOGLE_PRIVATE_KEY=
# TMDB v4 read access token. Server only.
TMDB_READ_TOKEN=
# OMDb API key. Leave empty to skip IMDb ratings. Server only.
OMDB_API_KEY=
# RAWG API key. Server only.
RAWG_API_KEY=
# Contact string sent as the Open Library user agent. Server only.
OPEN_LIBRARY_CONTACT=
# Optional Google Books API key. Covers work without a key at low volume. Server only.
GOOGLE_BOOKS_API_KEY=
# Jikan API base URL. Server only.
JIKAN_BASE_URL=https://api.jikan.moe/v4
# Optional IGDB client id. Server only.
IGDB_CLIENT_ID=
# Optional IGDB client secret. Server only.
IGDB_CLIENT_SECRET=
# Server flag for Pick for tonight. true or false.
FEATURE_PICKS=true
# Client flag baked in at build time. true or false. Not a secret.
VITE_FEATURE_PICKS=true
# Server flag. Adding rows stays off.
FEATURE_ADD=false
# Optional Gemini API key. Unused while adding rows is off. Server only.
GEMINI_API_KEY=
# Optional Gemini model id. Server only.
GEMINI_MODEL=
# Port for the local API process.
API_DEV_PORT=3001
